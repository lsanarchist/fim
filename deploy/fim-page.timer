[Unit]
Description=Daily page publication in the configured timezone
OnFailure=fim-failure@%n.service

[Timer]
# OnCalendar is supplied by fim-page-generator from /opt/fim/config.json.
# Without a valid generated schedule this timer deliberately refuses to start.
AccuracySec=1s
RandomizedDelaySec=0
Persistent=true
Unit=fim-page.service

[Install]
WantedBy=timers.target
