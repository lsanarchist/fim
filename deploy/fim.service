[Unit]
Description=FIM - file integrity monitoring of /var/www/fim
# At boot, write today's page first, so the monitor never sees yesterday's date.
After=network-online.target fim-page.service
Wants=network-online.target fim-page.service

[Service]
User=fim
Group=fim
ExecStart=/usr/local/bin/fim /etc/fim/config.json watch
Restart=on-failure
RestartSec=10
# The monitor can only write its database and log; the website is read-only for it.
ProtectSystem=strict
ReadWritePaths=/var/lib/fim /var/log/fim
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
