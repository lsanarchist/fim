[Unit]
Description=FIM - write today's date and name day into index.html

[Service]
Type=oneshot
ExecStart=/usr/local/bin/fim /etc/fim/config.json page
# Runs as root (owner of the website), but may only write the website and the log.
# The temporary file is created in /var/www, next to the site directory.
ProtectSystem=strict
ReadWritePaths=/var/www /var/log/fim
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
